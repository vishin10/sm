{
    "name": "silent-manager-agent",
    "version": "1.0.0",
    "description": "Back-office agent for Silent Manager - auto-uploads shift reports",
    "main": "dist/main/index.js",
    "scripts": {
        "dev": "npm run build && electron .",
        "build": "tsc && node scripts/copy-assets.js",
        "package": "npm run build && electron-builder",
        "package:win": "npm run build && electron-builder --win"
    },
    "author": "Silent Manager",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^20.4.0",
        "@types/node-notifier": "^8.0.5",
        "electron": "^28.0.0",
        "electron-builder": "^24.9.0",
        "typescript": "^5.3.0"
    },
    "dependencies": {
        "axios": "^1.6.0",
        "chokidar": "^3.5.3",
        "electron-store": "^8.1.0",
        "electron-updater": "^6.1.0",
        "form-data": "^4.0.0",
        "node-notifier": "^10.0.1"
    },
    "build": {
        "appId": "com.silentmanager.agent",
        "productName": "Silent Manager Agent",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "assets/**/*"
        ],
        "win": {
            "target": [
                "portable"
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        },
        "publish": {
            "provider": "github",
            "owner": "your-github-username",
            "repo": "silent-manager-agent"
        }
    }
}